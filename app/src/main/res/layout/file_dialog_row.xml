<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent" android:layout_height="wrap_content"
	android:minHeight="48dp">

	<ImageView android:layout_alignParentStart="true" android:id="@+id/fdrowimage"
		android:layout_height="48dp" android:layout_width="48dp"
		android:contentDescription="@string/file_or_folder_icon"
		android:paddingEnd="5dp" android:paddingStart="3dp"></ImageView>

	<TextView
	    android:id="@+id/fdrowtext"
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
	    android:layout_alignBottom="@+id/fdrowimage"
	    android:layout_alignTop="@+id/fdrowimage"
	    android:layout_toEndOf="@+id/fdrowimage"
	    android:gravity="center_vertical"
	    android:maxLines="1"
	    android:ellipsize="middle"
	    android:minHeight="48dp"
	    android:text="@+id/fdrowtext"
	    android:textSize="18sp" >
</TextView> 

</RelativeLayout>
