<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_settings_summary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/ai_endpoint"
            android:text="@string/ai_endpoint_label"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ai_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:imeOptions="actionNext"
            android:inputType="textUri|textNoSuggestions"
            android:maxLines="2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/ai_model"
            android:text="@string/ai_model_label"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/ai_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp" />

            <Button
                android:id="@+id/ai_refresh_models"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ai_refresh_models" />
        </LinearLayout>

        <TextView
            android:id="@+id/ai_model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/ai_custom_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ai_custom_model_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionNext"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/ai_api_key"
            android:text="@string/ai_api_key_label"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/ai_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ai_api_key_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:inputType="textPassword|textNoSuggestions"
            android:maxLines="1"
            android:saveEnabled="false" />

        <TextView
            android:id="@+id/ai_key_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp" />

        <Button
            android:id="@+id/ai_clear_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/ai_clear_key" />

        <Button
            android:id="@+id/ai_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/save" />

    </LinearLayout>
</ScrollView>
